{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Relia",
  "version": "0.1.0",
  "identifier": "local.crm.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "HOST=127.0.0.1 BROWSER=none yarn start",
    "beforeBuildCommand": "DISABLE_ESLINT_PLUGIN=true CI=false yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Relia",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMDNCMzgzNzA5RDEwMTgKUldRWUVKMXdnN01EclRNbno0b1h2dEVuR2dFRVUxNjB3Y2ZHdEZENktFUnNlMHpHS1kyWFZPRXAK",
      "endpoints": [
        "https://github.com/d3ltv/crm-desktop/releases/download/official/official.json"
      ]
    }
  }
}
